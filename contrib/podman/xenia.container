[Unit]
Description=Xenia — Unified AI Proxy
After=network-online.target
Wants=network-online.target
Requires=xenia-redis.service
After=xenia-redis.service

[Container]
# Use this image after building locally
Image=localhost/xenia:base
# Or use the fully qualified published image (there is no published :base tag)
# Image=docker.io/diegosouzapw/xenia:latest

ContainerName=xenia

Network=xenia.network
PublishPort=20128:20128
PublishPort=20129:20129

Volume=xenia.volume:/app/data:Z

# Use a bind mount if you need direct host access to the data:
# Volume=/home/USER/code/docker/Xenia/data:/app/data:Z

Environment=DATA_DIR=/app/data
Environment=PORT=20128
Environment=DASHBOARD_PORT=20128
Environment=API_PORT=20129
Environment=API_HOST=0.0.0.0
Environment=REDIS_URL=redis://redis:6379
Environment=JWT_SECRET=change-me-to-a-random-base64-string
Environment=API_KEY_SECRET=change-me-to-a-random-base64-string
Environment=INITIAL_PASSWORD=change-me-to-a-random-hex-string
Environment=NODE_ENV=production
Environment=REQUIRE_API_KEY=true

# Load additional secrets (API keys, OAuth creds) from the project .env:
# EnvironmentFile=%h/code/docker/Xenia/.env

HealthCmd=node /app/healthcheck.mjs
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
HealthStartPeriod=15s

[Service]
Restart=always

[Install]
WantedBy=default.target
